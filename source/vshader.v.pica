; PICA200 vertex shader — Phong lighting + UV passthrough for diffuse texture

; Uniforms
.fvec projection[4], modelView[4]
.fvec lightVec, lightHalfVec, lightClr, material[4]
.alias mat_amb material[0]
.alias mat_dif material[1]
.alias mat_spe material[2]
.alias mat_emi material[3]

; Constants
.constf myconst(0.0, 1.0, -1.0, -0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos   position
.out outclr   color
.out outtex0  texcoord0

; Inputs
.alias inpos v0
.alias inclr v1
.alias innrm v2
.alias intex v3

.proc main
	; Force the w component of inpos to be 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Transform the normal vector with the modelView matrix
	; r1 = normalize(modelView * innrm)
	mov r0.xyz, innrm
	mov r0.w,   zeros
	dp4 r1.x,   modelView[0], r0
	dp4 r1.y,   modelView[1], r0
	dp4 r1.z,   modelView[2], r0
	mov r1.w,   zeros
	dp3 r2,     r1, r1 ; r2 = x^2+y^2+z^2 for each component
	rsq r2,     r2     ; r2 = 1/sqrt(r2)
	mul r1,     r2, r1 ; r1 = normalized normal

	; Calculate the diffuse level (r0.x) and the shininess level (r0.y)
	dp3 r0.x, lightVec,      r1
	add r0.x, zeros,         -r0
	dp3 r0.y, -lightHalfVec, r1
	max r0,   zeros,         r0
	mul r0.y, r0,            r0

	; Accumulate the lighting result in r1, initializing to emission
	mov r1, mat_emi

	; r1 += specular * lightClr * shininessLevel
	mul r2, lightClr, r0.yyyy
	mad r1, r2, mat_spe, r1

	; r1 += diffuse * lightClr * diffuseLevel
	mul r2, lightClr, r0.xxxx
	mad r1, r2, mat_dif, r1

	; r1 += ambient * lightClr
	mov r2, lightClr
	mad r1, r2, mat_amb, r1

	; Modulate lighting result by per-vertex colour tint (white for textured models)
	mul r1.xyz, r1, inclr

	; outclr = clamp r1 to [0,1] — this is the lighting factor, not the final colour
	; TexEnv stage 0 will multiply this by the diffuse texture sample
	min outclr, ones, r1

	; Pass UV coordinates through to TexEnv
	mov outtex0.xy, intex
	mov outtex0.zw, zeros

	end
.end
